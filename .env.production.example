# Paste these settings into Dokploy's Compose environment editor.
# Replace every placeholder. Do not commit production secrets.
FRONTEND_URL=https://matric.example.com
EXTERNAL_SERVICES_NETWORK=dokploy-network
# Find the default Compose network subnet after creating the stack.
# Trust only the actual network carrying frontend-to-API traffic, never 0.0.0.0/0.
TRUSTED_PROXY_NETWORK=

# Use Npgsql key=value syntax, NOT a postgresql:// URL.
DATABASE_CONNECTION_STRING=Host=your-db-service;Port=5432;Database=matric_dashboard;Username=matric;Password=REPLACE_ME

# Generate once and keep stable across deployments.
# JWT_SECRET: openssl rand -base64 64
# EXT_AUTH_ENCRYPTION_KEY: openssl rand -base64 32
JWT_SECRET=
EXT_AUTH_ENCRYPTION_KEY=

MEILI_URL=http://your-meilisearch-service:7700
MEILI_MASTER_KEY=
GEOSERVER_BASE_URL=http://your-geoserver-service:8080/geoserver

# MinIO S3 API port, NOT its console port 9001.
FILE_STORAGE_ENDPOINT=http://your-minio-service:9000
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=
FILE_STORAGE_BUCKET=matric-dasbhoard-files
# Set true when using an HTTPS storage endpoint.
FILE_STORAGE_USE_SSL=false

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=MatricDasbhoard
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
PUBLIC_MAP_IMAGERY_URL=
PUBLIC_MAP_IMAGERY_ATTRIBUTION=
