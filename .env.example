# ── Database ──────────────────────────────────────────
POSTGRES_DB=matric_dashboard
POSTGRES_USER=matric
POSTGRES_PASSWORD=
# Compose preserves PostgreSQL 17 volumes by default. For a NEW PG18 volume or
# after dump/restore, set all three values per docs/spatial-operations.md:
# POSTGIS_IMAGE=postgis/postgis:18-3.6-alpine
# POSTGRES_VOLUME=postgres-data-pg18
# POSTGRES_VOLUME_TARGET=/var/lib/postgresql

# ── GeoServer (serves the PostGIS school layer) ───────
GEOSERVER_ADMIN_USER=admin
# Generate a secure password - never keep the default in a shared environment
GEOSERVER_ADMIN_PASSWORD=
# Loopback-only maintenance port, used by scripts/geoserver/bootstrap.sh
GEOSERVER_PORT=8080
# Base URL the API uses to reach GeoServer (compose service DNS by default)
GEOSERVER_BASE_URL=http://geoserver:8080/geoserver

# ── MinIO (S3-compatible file storage) ───────────────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=
FILE_STORAGE_BUCKET=matric-dasbhoard-files

# ── JWT / Auth ───────────────────────────────────────
# Generate a secure key: openssl rand -base64 64
JWT_SECRET=
# 32+ chars: openssl rand -base64 32
EXT_AUTH_ENCRYPTION_KEY=

# ── Email (SMTP) ─────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=MatricDasbhoard
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false

# ── Captcha (Cloudflare Turnstile) ───────────────────
TURNSTILE_SECRET_KEY=

# ── Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── CORS ─────────────────────────────────────────────
CORS_ALLOW_ALL=false

# ── vim-dadbod (SQLite NSC database) ─────────────────
# Single SQLite file with per-school overall results and per-school subject
# results (data/nsc/matric.db). Use an absolute path.
# DATABASE_URL backs :DB/$DATABASE_URL; DB_UI_* surfaces it in vim-dadbod-ui.
DATABASE_URL=sqlite:/absolute/path/to/repo/data/nsc/matric.db
DB_UI_NSC=sqlite:/absolute/path/to/repo/data/nsc/matric.db

# ── MeiliSearch (school search index) ────────────────
MEILI_URL=http://meilisearch:7700
# Generate a key with at least 16 characters: openssl rand -hex 32
MEILI_MASTER_KEY=
