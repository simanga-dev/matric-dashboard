# URL of the backend API
# When running in Docker, this is overridden to http://api:8080
API_URL=http://localhost:5175

# Cloudflare Turnstile CAPTCHA site key (public, passed to frontend via SSR layout data)
# Default: Cloudflare's always-pass test key (https://developers.cloudflare.com/turnstile/troubleshooting/testing/)
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Comma-separated list of additional origins allowed through the API proxy CSRF check
# (e.g. ngrok URLs, reverse proxy domains). Leave empty for same-origin only.
ALLOWED_ORIGINS=

# Optional licensed aerial/satellite XYZ tiles. Read at runtime, not build time.
# Both required. HTTPS URL must include {z}, {x}, {y}. Leave blank to use streets.
# Only public, origin-restricted provider keys belong in this browser-visible URL.
PUBLIC_MAP_IMAGERY_URL=
PUBLIC_MAP_IMAGERY_ATTRIBUTION=
