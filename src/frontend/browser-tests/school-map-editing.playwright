async (page) => {
	// Run from a signed-in editor session. The isolated context copies cookies,
	// but all spatial reads/writes below are fixtures and never reach the API.
	const context = await page.context().browser().newContext({
		storageState: await page.context().storageState(),
		viewport: { width: 1440, height: 1000 }
	});
	const browser = await context.newPage();
	const origin = new URL(page.url()).origin;
	const school = { id: '00123', name: 'SPATIAL TEST SCHOOL', province: 'GAUTENG', circuit: 'TEST CIRCUIT', totalWrote: 10, totalPassed: 9, passRate: 90, totalAchieved: null };
	const footprintAt = (longitude, latitude, radius = 0.0003) => ({ type: 'MultiPolygon', coordinates: [[[[longitude - radius, latitude - radius], [longitude + radius, latitude - radius], [longitude + radius, latitude + radius], [longitude - radius, latitude + radius], [longitude - radius, latitude - radius]]]] });
	let canonical = { emisNumber: school.id, revision: 0, boundary: null, footprint: null, footprintSource: 'missing', location: null, hasLocationOverride: false, locationSource: 'missing', areaSquareMetres: null, warnings: [] };
	let conflict = true;
	const writes = [];
	const check = (value, message) => { if (!value) throw new Error(message); };
	try {
		await browser.route('**/api/v1/dashboard/schools**', (route) => route.fulfill({ json:
			new URL(route.request().url()).pathname.endsWith(school.id)
				? { ...school, years: [], comparison: null }
				: { items: [school, { ...school, id: '00456', name: 'OTHER SCHOOL' }], totalCount: 2, pageNumber: 1, pageSize: 500, totalPages: 1, hasPreviousPage: false, hasNextPage: false }
		}));
		await browser.route('**/api/geo/**', (route) => {
			const layer = new URL(route.request().url()).searchParams.get('typeName');
			const geometry = layer === 'matric:school_footprints' ? canonical.footprint : layer === 'matric:school_boundaries' ? canonical.boundary : null;
			return route.fulfill({ json: { type: 'FeatureCollection', features: geometry ? [{ type: 'Feature', geometry, properties: { emis_number: school.id } }] : [] } });
		});
		await browser.route(/https:\/\/[^/]*tile\.openstreetmap\.org\//, (route) => route.fulfill({ contentType: 'image/svg+xml', body: '<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256"/>' }));
		await browser.route('**/api/v1/schools/*/spatial**', async (route) => {
			if (route.request().method() !== 'PUT') return route.fulfill({ json: route.request().url().endsWith('/history') ? [] : canonical });
			const body = route.request().postDataJSON(); writes.push({ url: route.request().url(), body });
			if (conflict) return route.fulfill({ status: 409, json: { detail: 'Stale revision' } });
			const point = body.location;
			const footprint = body.footprint ?? (point ? footprintAt(point.coordinates[0], point.coordinates[1]) : null);
			canonical = { ...canonical, revision: 1, boundary: body.boundary?.type === 'Polygon' ? { type: 'MultiPolygon', coordinates: [body.boundary.coordinates] } : body.boundary, footprint, footprintSource: body.footprint ? 'editor' : 'default', location: point, hasLocationOverride: true, locationSource: 'editor' };
			return route.fulfill({ json: canonical });
		});
		await browser.goto(`${origin}/overview?school=${school.id}`);
		const toolbar = browser.getByRole('toolbar', { name: 'Map tools' });
		const edit = toolbar.getByRole('button', { name: 'Edit school map', exact: true });
		await edit.waitFor();
		check(await edit.isVisible(), 'Requires a user granted schools.spatial.edit');
		check(
			await edit.evaluate((element) => element.getBoundingClientRect().width >= 44),
			'Map toolbar edit action must meet the 44px target'
		);
		await edit.click();
		const editor = browser.getByRole('region', { name: 'School map editor' });
		const addMarker = toolbar.getByRole('button', { name: 'Add marker', exact: true });
		await addMarker.waitFor();
		check(
			await addMarker.evaluate((element) => element.getBoundingClientRect().height >= 44),
			'Map toolbar edit actions must meet the 44px target'
		);
		await addMarker.click();
		await browser.locator('.school-map').click({ position: { x: 200, y: 180 } });
		await toolbar.getByRole('button', { name: 'Draw school grounds', exact: true }).click();
		for (const position of [{ x: 160, y: 140 }, { x: 240, y: 140 }, { x: 240, y: 220 }]) await browser.locator('.school-map').click({ position });
		await browser.locator('.school-map').dblclick({ position: { x: 160, y: 220 } });
		await editor.getByLabel('Reason for correction').fill('Verified school position');
		await editor.getByLabel('Source or evidence').fill('Field observation');
		// Any external region selection must not retarget the open draft. The
		// fixture school is not in the live directory, so use a stable tree node.
		await browser.getByRole('button', { name: /^Gauteng/ }).click();
		check((await editor.textContent()).includes(school.id), 'Tree selection changed immutable editor identity');
		await toolbar.getByRole('button', { name: 'Save school map', exact: true }).click();
		await editor.getByRole('alert').waitFor();
		check(await editor.getByLabel('Reason for correction').inputValue() === 'Verified school position', 'Conflict discarded draft evidence');
		check(writes[0].url.endsWith(`/schools/${school.id}/spatial`), 'Draft attached to the wrong EMIS');
		check(writes[0].body.locationMode === 'override' && writes[0].body.location.type === 'Point', 'Adding missing point did not create an override');
		check(writes[0].body.footprint?.type === 'Polygon', 'School grounds drawing did not save a footprint polygon');
		conflict = false;
		await toolbar.getByRole('button', { name: 'Save school map', exact: true }).click();
		await editor.waitFor({ state: 'detached' });
		await edit.click();
		await toolbar.getByRole('button', { name: 'Move marker', exact: true }).waitFor();
		const editFootprint = toolbar.getByRole('button', { name: 'Edit school grounds', exact: true });
		await editFootprint.waitFor();
		await editFootprint.click();
		check(await editFootprint.getAttribute('aria-pressed') === 'true', 'Footprint polygon tool was not activated');
		check(writes.length === 2, 'Expected one explicit retry after a conflict');
		await editor.getByLabel('Reason for correction').fill('Unpublished change');
		browser.once('dialog', (dialog) => dialog.dismiss());
		await toolbar.getByRole('button', { name: 'Cancel', exact: true }).click();
		check(await editor.isVisible(), 'Declining discard lost the draft');
		browser.once('dialog', (dialog) => dialog.accept());
		await toolbar.getByRole('button', { name: 'Cancel', exact: true }).click();
		await editor.waitFor({ state: 'detached' });
		const newer = (revision, longitude, latitude) => ({ ...canonical, revision, footprint: footprintAt(longitude, latitude), footprintSource: 'default', location: { type: 'Point', coordinates: [longitude, latitude] }, boundary: { type: 'MultiPolygon', coordinates: [[[[longitude - 0.05, latitude - 0.05], [longitude + 0.05, latitude - 0.05], [longitude + 0.05, latitude + 0.05], [longitude - 0.05, latitude + 0.05], [longitude - 0.05, latitude - 0.05]]]] } });
		const assertPublishedGeometry = async () => {
			await browser.waitForTimeout(500);
			check(await browser.locator('.school-map .ol-layer:not(.school-basemap):not(.school-imagery) canvas').last().evaluate((canvas) => {
				const context = canvas.getContext('2d');
				return [[20, 20], [-20, 20]].every(([x, y]) => context.getImageData(Math.round(canvas.width / 2 + x), Math.round(canvas.height / 2 + y), 1, 1).data[3] > 0);
			}), 'Published grounds were not rendered around the authoritative marker after draft removal');
		};
		// A newer GET must replace the map underneath the draft before Cancel.
		canonical = newer(2, 28, -26);
		await edit.click();
		await editor.getByText(/Revision 2/).waitFor();
		await toolbar.getByRole('button', { name: 'Cancel', exact: true }).click();
		await editor.waitFor({ state: 'detached' });
		await browser.getByRole('button', { name: 'Other School', exact: true }).click();
		await browser.getByRole('button', { name: 'Spatial Test School', exact: true }).click();
		await assertPublishedGeometry();
		// A later publication may be newer again, without reopening the editor.
		canonical = newer(3, 18, -33);
		const tileAtLatestMarker = browser.waitForRequest((request) => {
			const url = new URL(request.url());
			if (!url.hostname.endsWith('tile.openstreetmap.org')) return false;
			const [zoom, x, y] = url.pathname.slice(1).split('/').map(Number.parseFloat);
			const scale = 2 ** zoom;
			const expectedX = Math.floor((18 + 180) / 360 * scale);
			const expectedY = Math.floor((1 - Math.asinh(Math.tan(-33 * Math.PI / 180)) / Math.PI) / 2 * scale);
			return zoom >= 10 && Math.abs(x - expectedX) <= 1 && Math.abs(y - expectedY) <= 1;
		});
		await browser.getByRole('link', { name: 'Study Guide', exact: true }).first().click();
		await browser.getByRole('link', { name: 'Overview', exact: true }).first().click();
		await tileAtLatestMarker;
		// The remounted map fits the authoritative published point itself.
		await browser.getByRole('button', { name: 'Other School', exact: true }).click();
		await browser.getByRole('button', { name: 'Spatial Test School', exact: true }).click();
		await assertPublishedGeometry();
		return { missingMarkerAdded: true, groundsDrawn: true, treeSelectionFrozen: true, conflictRetainedDraft: true, canonicalSaveDisplayed: true, cancelConfirmed: true, newerGetCancelPublishedGeometry: true, remountRevalidatedPublishedPoint: true };
	} finally { await context.close(); }
}
